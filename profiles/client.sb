; vim:ft=scheme
;; client.sb — shared rules for the client tools, imported by pi.sb and
;; llm.sb after common.sb: shells, a TTY, name resolution via the hosts
;; file, and outbound network to the local model server only.

;; ── Process ──────────────────────────────────────────────
(allow process-exec
  (subpath (param "PKG_STORE"))
  (literal "/usr/bin/env")
  (literal "/bin/bash")
  (literal "/bin/zsh")
  (literal "/bin/sh"))

(allow process-fork)

;; ── Name resolution ──────────────────────────────────────
(allow file-read*
  (literal "/private/etc/hosts"))

;; ── TTY (interactive prompts / TUI rawmode) ──────────────
;; Only this process's controlling terminal, resolved by sandbox.sh (its
;; /dev/null fallback covers a non-interactive run). A pattern over
;; /dev/ttys* would hand over every other terminal on the machine — the
;; sessions you have open elsewhere — to read input from and write escape
;; sequences into. Path grants are enforced for ioctls on inherited
;; descriptors too, not just open(), so the real path has to be named:
;; the /dev/tty alias alone is not enough.
(allow file-read* file-write* file-ioctl
  (literal "/dev/tty")
  (literal (param "TTY_DEV")))

;; ── Network: the local model server only ─────────────────
(allow network-outbound
  (remote tcp (param "NET_ADDR")))
