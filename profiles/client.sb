; vim:ft=scheme
;; client.sb — shared rules for the client tools, imported by pi.sb and
;; llm.sb after common.sb: shells, a TTY, name resolution via the hosts
;; file, and outbound network to the local model server only.

;; ── Process ──────────────────────────────────────────────
(allow process-exec
  (subpath (param "PKG_STORE"))
  (literal "/usr/bin/env")
  (literal "/bin/bash")
  (literal "/bin/zsh")
  (literal "/bin/sh"))

(allow process-fork)

;; ── Name resolution ──────────────────────────────────────
(allow file-read*
  (literal "/private/etc/hosts"))

;; ── TTY (interactive prompts / TUI rawmode) ──────────────
(allow file-read* file-write* file-ioctl
  (subpath "/dev/tty")
  (subpath "/dev/pty")
  (regex #"^/dev/ttys[0-9]+$"))

;; ── Network: the local model server only ─────────────────
(allow network-outbound
  (remote tcp (param "NET_ADDR")))
