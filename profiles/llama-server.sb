; vim:ft=scheme
(version 1)
(deny default)

;; llama-server sandbox — everything but the binary comes from server.sb
(import (param "COMMON_SB"))
(import (param "SERVER_SB"))

;; ── Process: the single pinned binary ────────────────────
(allow process-exec
  (literal (param "LLAMA_SERVER")))

;; ── Projector, draft model, chat template (read-only) ────
;; The model itself is covered by server.sb's MODEL_DIR rule. MMPROJ_DIR
;; and DRAFT_DIR fall back to MODEL_DIR, and CHAT_TEMPLATE_FILE to
;; /dev/null, when not in play — sandbox-exec errors out on parameters
;; referenced but not passed.
(allow file-read*
  (subpath (param "MMPROJ_DIR"))
  (subpath (param "DRAFT_DIR"))
  (literal (param "CHAT_TEMPLATE_FILE")))
