; vim:ft=scheme
;; server.sb — shared rules for the model servers, imported by
;; llama-server.sb and mlx-server.sb after common.sb: GPU access, model
;; weights and caches, and the serving network personality. Each server
;; adds its own executable rule.

(deny process-fork)

;; ── Mach (GPU) ───────────────────────────────────────────
;; Shader compilation runs in an XPC service, so it needs an
;; xpc-service-name lookup — common.sb denies the wildcard that (version 1)
;; would otherwise hand out. Only reached when the Metal cache is cold:
;; with a warm cache llama.cpp loads a precompiled library and never asks,
;; which is why this is easy to break without noticing. The GPU-daemon
;; global-names that used to be here (gpumemd, metal.shared,
;; GPUCompiler.daemon) are not needed even from cold.
(allow mach-lookup
  (xpc-service-name "com.apple.MTLCompilerService"))

;; ── IOKit: GPU ───────────────────────────────────────────
;; Metal only, and only the two user clients that turn out to be load
;; bearing: the AGX* trio and IOAcceleratorClient are alternative paths
;; the drivers no longer take here, and the Neural Engine clients were
;; never in play (neither llama.cpp nor MLX reaches the ANE — that is
;; CoreML). What remains cannot be reduced further: it is what talking to
;; the GPU requires (see the README on what this sandbox does not
;; contain).
(allow iokit-open
  (iokit-user-client-class "IOGPUDeviceUserClient")
  (iokit-user-client-class "IOSurfaceRootUserClient"))

;; ── Filesystem ───────────────────────────────────────────
;; Model weights (read-only)
(allow file-read*
  (subpath (param "MODEL_DIR")))

;; Metal shader / PSO cache. No TMPDIR: the one concrete use anyone could
;; name for it — Python's tempfile, where mlx-vlm was assumed to spool
;; uploaded images — does not happen. Both engines answer questions about
;; a 3.2 MB image with this grant removed.
(allow file-read* file-write* file-lock
  (subpath (param "CACHE_DIR")))

;; ── Apple's per-user temp/cache (servers only) ───────────
;; Metal and CoreFoundation reach these via confstr(_CS_DARWIN_USER_*_DIR);
;; TMPDIR cannot redirect them, and shader compilation needs to map from
;; them executable. Granted here rather than in common.sb so the clients —
;; which have no GPU work to do — cannot reach the shader/PSO cache that a
;; server later loads while holding the GPU and the weights. Within the
;; cache only Metal's own two namespaces are granted; the other ~200 belong
;; to unrelated applications. sandbox.sh creates them if absent.
(allow file-read* file-write* file-map-executable file-lock
  (subpath (param "DARWIN_USER_TEMP_DIR"))
  (subpath (param "DARWIN_METAL_CACHE"))
  (subpath (param "DARWIN_METALFE_CACHE")))

;; ── Sandbox extensions for MTLCompilerService ──────────
;; The compiler XPC service reaches those paths through extensions the
;; server issues. Needed by MLX from a cold cache — llama.cpp survives
;; without it, MLX does not.
(allow file-issue-extension
  (require-all
    (extension-class "com.apple.app-sandbox.read-write")
    (require-any
      (subpath (param "DARWIN_USER_TEMP_DIR"))
      (subpath (param "DARWIN_METAL_CACHE"))
      (subpath (param "DARWIN_METALFE_CACHE")))))

;; ── Network ──────────────────────────────────────────────
;; Serving personality chosen by sandbox.sh — see net-tcp.sb / net-unix.sb.
;; Outbound denied: the model is fully local, so the server has no reason
;; to dial out.
(import (param "NET_SB"))

(deny network-outbound (with send-signal SIGKILL))
