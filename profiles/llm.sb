; vim:ft=scheme
(version 1)
(deny default)

;; llm CLI sandbox — shells, TTY and server-dialing come from client.sb;
;; this file adds llm's own state and nothing else.
;;
;; The TLS and network-configuration grants this used to carry (/etc/ssl,
;; SystemConfiguration, preference domains) are gone: the only endpoint
;; this sandbox can reach is the local server, so there is no TLS session
;; to establish and no proxy configuration to consult.
(import (param "COMMON_SB"))
(import (param "CLIENT_SB"))

;; ── LLM state (HOME points here) + scratch ───────────────
(allow file-read* file-write*
  (subpath (param "LLM_USER_PATH"))
  (subpath (param "TMPDIR")))
