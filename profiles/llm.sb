; vim:ft=scheme
(version 1)
(deny default)

;; llm CLI sandbox — shells/TTY/server-dialing come from client.sb, this
;; file adds llm's state and Python's TLS/config probing on top.
(import (param "COMMON_SB"))
(import (param "CLIENT_SB"))

;; ── LLM state ──────────────────────────────────────────
(allow file-read* file-write*
  (subpath (param "LLM_USER_PATH"))
  (subpath (param "TMPDIR")))

;; ── CoreFoundation / preferences ─────────────────────────
(allow user-preference-read)

;; ── Network config + TLS ─────────────────────────────────
(allow file-read-metadata
  (subpath "/etc")
  (subpath "/private/etc"))
(allow file-read*
  (subpath "/private/etc/ssl")
  (subpath "/etc/ssl"))
(allow mach-lookup
  (global-name "com.apple.SystemConfiguration.configd"))
