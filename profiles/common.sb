; vim:ft=scheme
;; common.sb — base rules imported first by every profile; the servers
;; additionally import server.sb, the clients client.sb.

(import "system.sb")
(import "com.apple.corefoundation.sb")

;; ── Process basics ───────────────────────────────────────
(allow signal (target self))
(allow process-info-pidinfo)

;; ── Mach (common) ────────────────────────────────────────
(allow mach-lookup
  (global-name "com.apple.system.opendirectoryd.membership"))

;; ── Sysctl (read-only, common subset) ────────────────────
(allow sysctl-read
  (sysctl-name "hw.ncpu")
  (sysctl-name "hw.memsize")
  (sysctl-name "hw.pagesize")
  (sysctl-name "kern.osrelease")
  (sysctl-name "kern.osversion"))

;; ── System libs (dyld, macOS frameworks) ─────────────────
(allow file-read*
  (subpath "/usr/lib")
  (subpath "/System/Library/Frameworks")
  (subpath "/System/Library/PrivateFrameworks")
  (subpath "/System/Library/Caches/com.apple.dyld")
  (subpath "/Library/Apple/usr/lib")
  (literal "/dev/null")
  (literal "/dev/zero")
  (literal "/dev/random")
  (literal "/dev/urandom"))

;; ── Package store (read + executable mapping) ───────────
;; Set by sandbox.sh: /nix for Nix, /opt/homebrew for Homebrew.
(allow file-read* file-map-executable
  (subpath (param "PKG_STORE")))

;; ── NSTemporaryDirectory ──────────────────────────────────
;; Apple frameworks (Metal, CoreFoundation) use confstr(_CS_DARWIN_USER_TEMP_DIR)
;; which resolves to /private/var/folders/<xx>/<hash>/T/. This cannot be
;; redirected via TMPDIR. sandbox.sh resolves the two per-user directories
;; (getconf DARWIN_USER_TEMP_DIR / DARWIN_USER_CACHE_DIR) so the grant stays
;; off the rest of /private/var/folders, which holds every other app's
;; temp/cache state for this user. file-map-executable is needed for Metal
;; shader compilation.
(allow file-read* file-write* file-map-executable file-lock
  (subpath (param "DARWIN_USER_TEMP_DIR"))
  (subpath (param "DARWIN_USER_CACHE_DIR")))

;; ── Path traversal (stat on parent directories) ─────────
;; SQLite and other tools need to stat() ancestor directories
;; when resolving absolute paths, and the per-user darwin dirs
;; granted above sit two levels inside /private/var/folders.
;; This only allows metadata (directory existence checks), not
;; reading file contents.
(allow file-read-metadata
  (subpath "/Users")
  (subpath "/private/var/folders"))

;; ── Logging ──────────────────────────────────────────────
(allow file-write*
  (literal "/dev/stdout")
  (literal "/dev/stderr"))
