; vim:ft=scheme
;; common.sb — base sandbox rules shared by every profile. Imported directly by
;; llama-server.sb, llm.sb, and agent.sb (which opencode.sb and pi.sb import).

(import "system.sb")
(import "com.apple.corefoundation.sb")

;; ── Process basics ───────────────────────────────────────
(allow signal (target self))
(allow process-info-pidinfo)

;; ── Mach (common) ────────────────────────────────────────
(allow mach-lookup
  (global-name "com.apple.system.opendirectoryd.membership"))

;; ── Sysctl (read-only, common subset) ────────────────────
(allow sysctl-read
  (sysctl-name "hw.ncpu")
  (sysctl-name "hw.memsize")
  (sysctl-name "hw.pagesize")
  (sysctl-name "kern.osrelease")
  (sysctl-name "kern.osversion"))

;; ── System libs (dyld, macOS frameworks) ─────────────────
(allow file-read*
  (subpath "/usr/lib")
  (subpath "/System/Library/Frameworks")
  (subpath "/System/Library/PrivateFrameworks")
  (subpath "/System/Library/Caches/com.apple.dyld")
  (subpath "/Library/Apple/usr/lib")
  (literal "/dev/null")
  (literal "/dev/zero")
  (literal "/dev/random")
  (literal "/dev/urandom"))

;; ── Package store (read + executable mapping) ───────────
;; Set by sandbox.sh: /nix for Nix, /opt/homebrew for Homebrew.
(allow file-read* file-map-executable
  (subpath (param "PKG_STORE")))

;; ── NSTemporaryDirectory ──────────────────────────────────
;; Apple frameworks (Metal, CoreFoundation) use confstr(_CS_DARWIN_USER_TEMP_DIR)
;; and _CS_DARWIN_USER_CACHE_DIR, which resolve to /private/var/folders/.../T/
;; and .../C/. These cannot be redirected via TMPDIR. Scoped to this user's two
;; dirs (passed by sandbox.sh from getconf) rather than all of /private/var/folders,
;; which also holds every other user's and the system daemons' temp state. These
;; dirs are still shared with the user's other non-sandboxed processes — the
;; per-user temp dir cannot be isolated further.
;;
;; file-map-executable is deliberately NOT granted here: only Metal shader
;; compilation maps compiled binaries executable out of these dirs, so that
;; capability is scoped to llama-server.sb. The coding agents (opencode/pi/llm)
;; write framework temp/cache here but never map it executable — withholding it
;; removes a plant-an-executable channel into the shared per-user dirs.
(allow file-read* file-write* file-lock
  (subpath (param "USER_TMP"))
  (subpath (param "USER_CACHE"))
)

;; ── Path traversal (stat on parent directories) ─────────
;; SQLite and other tools need to stat() ancestor directories
;; when resolving absolute paths. This only allows metadata
;; (directory existence checks), not reading file contents.
(allow file-read-metadata
  (subpath "/Users"))

;; ── Logging ──────────────────────────────────────────────
(allow file-write*
  (literal "/dev/stdout")
  (literal "/dev/stderr"))
