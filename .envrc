use flake

# `use flake` (nix-direnv) only watches flake.nix and flake.lock. But the
# `sandboxed-ai` package this flake builds also embeds the launcher (sandbox.sh)
# and the seatbelt profiles (*.sb) via its src fileset, so editing any of them
# changes the derivation. We must watch those too — and with
# nix_direnv_watch_file, not plain watch_file: the former also invalidates
# nix-direnv's cache, so a change actually rebuilds the dev shell instead of
# reloading into the stale cached one. Falls back to watch_file if nix-direnv
# ever isn't providing the helper.
_watch_sandboxed_ai() {
  if declare -f nix_direnv_watch_file >/dev/null 2>&1; then
    nix_direnv_watch_file "$@"
  else
    watch_file "$@"
  fi
}

# Match the flake's src fileset. nullglob so a missing *.sb can't leave the
# literal "*.sb" in the list; the glob re-expands on every reload, so profiles
# added later are picked up automatically once any watched file triggers a reload.
shopt -s nullglob
_watch_sandboxed_ai sandbox.sh *.sb
shopt -u nullglob
