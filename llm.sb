; vim:ft=scheme
(version 1)
(deny default)

;; llm CLI sandbox
(import (param "COMMON_SB"))

;; ── Process ──────────────────────────────────────────────
(allow process-exec
  (subpath (param "PKG_STORE"))
  (literal "/usr/bin/env")
  (literal "/bin/bash")
  (literal "/bin/sh"))

(allow process-fork)

;; ── LLM state ──────────────────────────────────────────
(allow file-read* file-write*
  (subpath (param "LLM_USER_PATH"))
  (subpath (param "TMPDIR")))

;; ── CoreFoundation / preferences ─────────────────────────
(allow user-preference-read)

;; ── Network config + TLS ─────────────────────────────────
(allow file-read-metadata
  (subpath "/etc")
  (subpath "/private/etc"))
(allow file-read*
  (literal "/private/etc/hosts")
  (subpath "/private/etc/ssl")
  (subpath "/etc/ssl"))
(allow mach-lookup
  (global-name "com.apple.SystemConfiguration.configd"))

;; ── Network: localhost llama-server only ──────────────────
(allow network-outbound
  (remote tcp (param "NET_ADDR")))

;; ── TTY (interactive prompts) ────────────────────────────
;; /dev/tty is the per-process controlling-terminal magic file — it always
;; resolves to this process's own tty, so it is self-scoped. TTY_DEV (from
;; sandbox.sh) is this session's concrete slave device, pinned so a compromised
;; agent cannot read or write another terminal session's /dev/ttysN.
(allow file-read* file-write* file-ioctl
  (literal "/dev/tty")
  (literal (param "TTY_DEV")))
