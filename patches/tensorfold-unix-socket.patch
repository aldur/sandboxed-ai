+    def __init__(self, address, handler):
+        self.unix_socket = address[0].endswith(".sock")
+        if self.unix_socket:
+            self.address_family = socket.AF_UNIX
+            address = address[0]
+        super().__init__(address, handler)
+
+    def server_bind(self):
+        if not self.unix_socket:
+            return super().server_bind()
+        # The launcher checks and removes stale sockets before entering
+        # the sandbox. Bind owner-only regardless of the caller's umask.
+        previous = os.umask(0o177)
+        try:
+            self.socket.bind(self.server_address)
+        finally:
+            os.umask(previous)
+        os.chmod(self.server_address, 0o600)
+        self.server_name, self.server_port = "localhost", 0
+
+    def get_request(self):
+        request, address = super().get_request()
+        return request, ("unix", 0) if self.unix_socket else address


