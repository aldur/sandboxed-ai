+@pytest.mark.parametrize("length, trim", [(0, 0), (8, 0), (8, 3), (256, 0), (257, 0)])
+def test_turboquant_from_cache_preserves_active_length(length, trim):
+    source = KVCache()
+    if length:
+        source.update_and_fetch(
+            mx.random.normal((1, 2, length, 32)),
+            mx.random.normal((1, 2, length, 32)),
+        )
+        source.trim(trim)
+
+    converted = TurboQuantKVCache.from_cache(source, bits=3.5)
+
+    assert converted.offset == length - trim
+    if length:
+        keys, values = converted.dequantize(*converted.state)
+        assert keys.shape == (1, 2, length - trim, 32)
+        assert values.shape == keys.shape
+
