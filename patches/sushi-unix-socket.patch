diff --git a/src/unix_listener.zig b/src/unix_listener.zig
new file mode 100644
index 0000000..23498e2
--- /dev/null
+++ b/src/unix_listener.zig
@@ -0,0 +1,115 @@
+const std = @import("std");
+
+pub const ListenError = error{ InvalidHost, NameTooLong, FileNotFound } || std.Io.net.IpAddress.ListenError;
+
+pub fn isUnix(host: []const u8) bool {
+    return std.mem.endsWith(u8, host, ".sock");
+}
+
+fn address(path: []const u8) ListenError!std.posix.sockaddr.un {
+    var sa = std.posix.sockaddr.un{ .path = @splat(0) };
+    if (path.len == 0 or std.mem.indexOfScalar(u8, path, 0) != null) return error.InvalidHost;
+    if (path.len >= sa.path.len) return error.NameTooLong;
+    @memcpy(sa.path[0..path.len], path);
+    return sa;
+}
+
+// std.Io.net's stream I/O accepts any socket descriptor, but its address
+// union and accept implementation only support IP. UNIX peers are local:
+// use a loopback tag for the existing HTTP authorization checks, without
+// opening any IP sockets.
+const local_peer: std.Io.net.IpAddress = .{ .ip4 = .{ .bytes = .{ 127, 0, 0, 1 }, .port = 0 } };
+
+pub fn listen(path: []const u8) ListenError!std.Io.net.Server {
+    const sa = try address(path);
+    const rc = std.posix.system.socket(std.posix.AF.UNIX, std.posix.SOCK.STREAM, 0);
+    const fd: std.posix.socket_t = switch (std.posix.errno(rc)) {
+        .SUCCESS => @intCast(rc),
+        .MFILE => return error.ProcessFdQuotaExceeded,
+        .NFILE => return error.SystemFdQuotaExceeded,
+        .NOMEM, .NOBUFS => return error.SystemResources,
+        else => return error.Unexpected,
+    };
+    errdefer _ = std.posix.system.close(fd);
+    if (std.posix.errno(std.posix.system.fcntl(fd, std.posix.F.SETFD, @as(usize, std.posix.FD_CLOEXEC))) != .SUCCESS) return error.Unexpected;
+    // UNIX clients bypass API-key auth like loopback clients. Never expose
+    // that socket to another user, even outside the sandbox wrapper.
+    const old_umask = std.posix.system.umask(0o177);
+    const bind_rc = std.posix.system.bind(fd, @ptrCast(&sa), @sizeOf(@TypeOf(sa)));
+    const bind_errno = std.posix.errno(bind_rc);
+    _ = std.posix.system.umask(old_umask);
+    switch (bind_errno) {
+        .SUCCESS => {},
+        .ADDRINUSE => return error.AddressInUse,
+        .ACCES, .PERM => return error.AccessDenied,
+        .NOENT => return error.FileNotFound,
+        .NOMEM, .NOBUFS => return error.SystemResources,
+        else => return error.Unexpected,
+    }
+    // Only remove a path after our own bind succeeded. A live socket,
+    // symlink or ordinary file at this path is never unlinked on startup.
+    errdefer cleanup(path);
+    if (std.posix.errno(std.posix.system.listen(fd, 128)) != .SUCCESS) return error.Unexpected;
+    return .{ .socket = .{ .handle = fd, .address = local_peer }, .options = {} };
+}
+
+pub fn cleanup(path: []const u8) void {
+    const sa = address(path) catch return;
+    _ = std.posix.system.unlink(@ptrCast(&sa.path));
+}
+
+pub fn ensureFree(io: std.Io, path: []const u8) ListenError!void {
+    var probe = try listen(path);
+    defer cleanup(path);
+    probe.deinit(io);
+}
+
+pub fn accept(server: *std.Io.net.Server) std.Io.net.Server.AcceptError!std.Io.net.Stream {
+    const rc = std.posix.system.accept(server.socket.handle, null, null);
+    const fd: std.posix.socket_t = switch (std.posix.errno(rc)) {
+        .SUCCESS => @intCast(rc),
+        .INTR => return error.Canceled,
+        .AGAIN => return error.WouldBlock,
+        .CONNABORTED => return error.ConnectionAborted,
+        .MFILE => return error.ProcessFdQuotaExceeded,
+        .NFILE => return error.SystemFdQuotaExceeded,
+        .NOMEM, .NOBUFS => return error.SystemResources,
+        else => return error.Unexpected,
+    };
+    errdefer _ = std.posix.system.close(fd);
+    if (std.posix.errno(std.posix.system.fcntl(fd, std.posix.F.SETFD, @as(usize, std.posix.FD_CLOEXEC))) != .SUCCESS) return error.Unexpected;
+    return .{ .socket = .{ .handle = fd, .address = local_peer } };
+}
+
+test "UNIX listener: path validation and local peer classification" {
+    try std.testing.expect(isUnix("/tmp/sushi.sock"));
+    try std.testing.expect(!isUnix("127.0.0.1"));
+    try std.testing.expectError(error.NameTooLong, address(&(@as([104]u8, @splat('x')))));
+    try std.testing.expectError(error.InvalidHost, address("x\x00.sock"));
+    const sa = try address("/tmp/sushi.sock");
+    try std.testing.expectEqual(std.posix.AF.UNIX, sa.family);
+    try std.testing.expectEqualStrings("/tmp/sushi.sock", std.mem.sliceTo(&sa.path, 0));
+    try std.testing.expectEqual(@as(u8, 127), local_peer.ip4.bytes[0]);
+}
+
+test "UNIX listener: private bind, collision refusal and probe cleanup" {
+    const io = std.testing.io;
+    var temp = std.testing.tmpDir(.{});
+    defer temp.cleanup();
+    var path_buf: [96]u8 = undefined;
+    const path = try std.fmt.bufPrint(&path_buf, ".zig-cache/tmp/{s}/sushi.sock", .{temp.sub_path});
+    try ensureFree(io, path);
+    try std.testing.expectError(error.FileNotFound, temp.dir.statFile(io, "sushi.sock", .{}));
+    {
+        var server = try listen(path);
+        defer cleanup(path);
+        defer server.deinit(io);
+        const info = try temp.dir.statFile(io, "sushi.sock", .{});
+        try std.testing.expectEqual(.unix_domain_socket, info.kind);
+        try std.testing.expectEqual(@as(std.posix.mode_t, 0o600), info.permissions.toMode() & 0o777);
+        try std.testing.expectError(error.AddressInUse, listen(path));
+        try std.testing.expectError(error.AddressInUse, ensureFree(io, path));
+        _ = try temp.dir.statFile(io, "sushi.sock", .{});
+    }
+    try std.testing.expectError(error.FileNotFound, temp.dir.statFile(io, "sushi.sock", .{}));
+}
