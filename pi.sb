; vim:ft=scheme
(version 1)
(deny default)

;; pi (pi-coding-agent) sandbox. Shared coding-agent rules live in agent.sb
;; (which imports common.sb); only pi-specific grants are below.
(import (param "AGENT_SB"))

;; ── pi state (~/.pi etc.; HOME points here) ──────────────
(allow file-read* file-write*
  (subpath (param "PI_DIR")))

;; ── llama-cpp provider extension (read-only, from store) ─
;; Covered by common.sb's PKG_STORE rule, but the explicit path makes the
;; dependency obvious and survives a narrower PKG_STORE.
(allow file-read*
  (subpath (param "PI_LLAMA_DIR")))
