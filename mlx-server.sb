; vim:ft=scheme
(version 1)
(deny default)

;; mlx_lm.server sandbox — Python + MLX (Metal), modeled on llama-server.sb
(import (param "COMMON_SB"))

;; ── Process ──────────────────────────────────────────────
;; Unlike llama-server (a single binary pinned by literal path),
;; mlx_lm.server is a Python entry-point script whose shebang execs the
;; interpreter out of the package store, so exec is allowed store-wide.
(allow process-exec
  (subpath (param "PKG_STORE"))
  ;; Metal shader compiler (metalfe) lives in system frameworks
  (subpath "/System/Library/Frameworks/Metal.framework")
  (subpath "/System/Library/PrivateFrameworks"))

(deny process-fork)

;; ── Mach (GPU) ───────────────────────────────────────────
(allow mach-lookup
  (global-name "com.apple.gpumemd.shared")
  (global-name "com.apple.metal.shared")
  (global-name "com.apple.GPUCompiler.daemon"))

;; ── IOKit: GPU + ANE ─────────────────────────────────────
(allow iokit-open
  (iokit-user-client-class "AGXDeviceUserClient")
  (iokit-user-client-class "AGXCommandQueueUserClient")
  (iokit-user-client-class "AGXSharedUserClient")
  (iokit-user-client-class "H11ANEUserClient")
  (iokit-user-client-class "AppleH11ANEUserClientV2")
  (iokit-user-client-class "ANEUserClient")
  (iokit-user-client-class "IOAcceleratorClient")
  (iokit-user-client-class "IOGPUDeviceUserClient")
  (iokit-user-client-class "IOSurfaceRootUserClient"))

(allow iokit-get-properties
  (iokit-property "gpu-core-count")
  (iokit-property "MetalPluginName")
  (iokit-property "MetalPluginClassName")
  (iokit-property "model"))

;; ── Sysctl (hardware topology for thread scheduling) ─────
(allow sysctl-read
  (sysctl-name "hw.physicalcpu")
  (sysctl-name-prefix "hw.optional.")
  (sysctl-name "hw.nperflevels")
  (sysctl-name-prefix "hw.perflevel")
  ;; CPython/its deps probe these on Apple Silicon
  (sysctl-name "hw.machine")
  (sysctl-name "kern.osproductversion")
  (sysctl-name "sysctl.proc_translated"))

;; ── Filesystem ───────────────────────────────────────────
;; GPU shader bundles
(allow file-read*
  (subpath "/Library/GPUBundles")
  (subpath "/System/Library/GPUBundles"))

;; python's platform.mac_ver() reads the version plist
(allow file-read*
  (literal "/System/Library/CoreServices/SystemVersion.plist"))

;; Python's http.server calls getfqdn() at bind; with the hosts file
;; readable, libinfo resolves 127.0.0.1 → localhost from it and never
;; falls through to mDNSResponder (whose socket the deny below kills on).
(allow file-read*
  (literal "/private/etc/hosts"))

;; TLS trust store — the CA bundle certifi opens
(allow file-read*
  (literal (param "CA_FILE")))

;; Model weights (read-only)
(allow file-read*
  (subpath (param "MODEL_DIR")))

;; Metal shader / PSO cache, HF hub cache (HOME is rooted here) + local temp
(allow file-read* file-write* file-lock
  (subpath (param "CACHE_DIR"))
  (subpath (param "TMPDIR")))

;; ── Sandbox extensions for MTLCompilerService ──────────
;; Metal shader compilation runs in an XPC service (MTLCompilerService).
;; It needs sandbox extensions issued by the server to access paths,
;; scoped to the per-user darwin temp/cache dirs it works in.
(allow file-issue-extension
  (require-all
    (extension-class "com.apple.app-sandbox.read-write")
    (require-any
      (subpath (param "DARWIN_USER_TEMP_DIR"))
      (subpath (param "DARWIN_USER_CACHE_DIR")))))

;; ── Shared memory (Metal command buffers) ────────────────
(allow ipc-posix-shm-read-data
       ipc-posix-shm-write-data
       ipc-posix-shm-write-create
  (ipc-posix-name-prefix "com.apple.metal")
  (ipc-posix-name-prefix "com.apple.GPUCompiler")
  (ipc-posix-name-prefix "com.apple.ane"))

;; ── Network ──────────────────────────────────────────────
;; Serving personality chosen by sandbox.sh — see net-tcp.sb / net-unix.sb.
;; Outbound denied: the model is fully local and HF_HUB_OFFLINE=1 is set,
;; so the server has no reason to dial out.
(import (param "NET_SB"))

(deny network-outbound (with send-signal SIGKILL))

;; Safety net for any lookup the hosts file doesn't answer: libinfo then
;; dials mDNSResponder over its UNIX socket. Still denied — but without
;; the SIGKILL above, so the resolver gets EPERM and fails gracefully
;; instead of the process dying mid-lookup. Must stay after the blanket
;; deny: the last matching rule wins.
(deny network-outbound (literal "/private/var/run/mDNSResponder"))
